{
  "name": "source-vs-npm",
  "version": "1.0.0",
  "description": "A tool to check that the most popular npm packages contain what you get when you build them from source.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/auditAll.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && node update-imports.js",
    "dev": "tsc --watch",
    "start": "node dist/auditAll.js",
    "lint": "eslint --ext .ts .",
    "audit": "npm run build && node dist/scripts/run-audit.js",
    "clean": "rm -rf dist",
    "update-imports": "node update-imports.js"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "download-counts": "*"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.30.1",
    "@eslint/json": "^0.12.0",
    "@types/diff": "^5.0.3",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "typescript": "^5.3.3"
  }
}
